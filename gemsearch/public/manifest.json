{
  "manifest_version": 3,
  "name": "GemSearch",
  "version": "0.1.0",
  "description": "Semantic search for YouTube. Find videos and moments instantly.",
  "author": "Art1san",
  
  "permissions": [
    "storage",
    "activeTab"
  ],
  
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "css": ["styles/base.css", "styles/components.css"],
    "run_at": "document_idle"
  }],
  
  "web_accessible_resources": [{
    "resources": ["styles/themes/*.css", "icons/*"],
    "matches": ["https://www.youtube.com/*"]
  }],
  
  "icons": {
    "16": "icons/gem-16.png",
    "48": "icons/gem-48.png",
    "128": "icons/gem-128.png"
  }
}
